<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="de-AT"><info><link rel="self" href="x"/></info><macro name="m"><names variable="author"><name and="text" initialize-with=". "/><label form="short"/><et-al/><substitute><text variable="title"/></substitute></names></macro><locale xml:lang="de"><terms><term name="and">und</term></terms></locale><citation collapse="year" disambiguate-add-year-suffix="true"><sort><key macro="m" names-min="3"/><key variable="issued"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><text macro="m"/><date variable="issued" form="text"><date-part name="year"/></date><choose><if type="book" match="any"><number variable="edition" form="ordinal"/></if><else-if position="ibid"><text term="ibid"/></else-if><else><label variable="page" form="short"/></else></choose></group></layout></citation><bibliography hanging-indent="true"><layout><text variable="year-suffix"/></layout></bibliography></style>